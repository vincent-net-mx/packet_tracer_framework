/* Markdown mínimo (inline, listas, tablas) */
function inl(s){return String(s).split(/(`[^`\n]+`)/).map((p,i)=>{
  if(i%2)return '<code>'+E(p.slice(1,-1))+'</code>';
  let h=E(p);h=h.replace(/\*\*(?!\s)(.+?)(?<!\s)\*\*/g,'<strong>$1</strong>');
  return h.replace(/(^|[^\w*])\*(?!\s)([^*\n]+?)(?<!\s)\*(?![\w*])/g,'$1<em>$2</em>')}).join('')}
const reLi=/^\s*([-*+]|\d+[.)])\s+/,reTb=/^\s*\|.*\|\s*$/;
function md(text){const L=String(text).replace(/\r/g,'').split('\n');let out='',i=0;
  while(i<L.length){const l=L[i];if(!l.trim()){i++;continue}
    if(reTb.test(l)&&i+1<L.length&&/^\s*\|?[\s:|-]+\|?\s*$/.test(L[i+1])&&L[i+1].includes('-')){
      const row=r=>r.trim().replace(/^\||\|$/g,'').split('|').map(c=>c.trim());const head=row(l);i+=2;const rows=[];
      while(i<L.length&&/^\s*\|/.test(L[i])){rows.push(row(L[i]));i++}
      out+='<div class="tbl"><table><thead><tr>'+head.map(c=>'<th>'+inl(c)+'</th>').join('')+'</tr></thead><tbody>'+rows.map(r=>'<tr>'+r.map(c=>'<td>'+inl(c)+'</td>').join('')+'</tr>').join('')+'</tbody></table></div>';continue}
    if(reLi.test(l)){const ord=/^\s*\d+[.)]/.test(l),items=[];while(i<L.length&&reLi.test(L[i])){items.push(L[i].replace(reLi,''));i++}
      out+=(ord?'<ol>':'<ul>')+items.map(x=>'<li>'+inl(x)+'</li>').join('')+(ord?'</ol>':'</ul>');continue}
    const para=[l];i++;while(i<L.length&&L[i].trim()&&!reTb.test(L[i])&&!reLi.test(L[i])){para.push(L[i]);i++}
    out+='<p>'+para.map(inl).join('<br>')+'</p>'}
  return out}

