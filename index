<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Framework de prácticas · Packet Tracer</title>
<script>try{if(localStorage.getItem("pt_ui_theme")==="dark")document.documentElement.classList.add("dark")}catch(e){}</script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans:wght@300;400;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">
<style>
:root{--bg:#fff;--l1:#f4f4f4;--l2:#e0e0e0;--bd:#e0e0e0;--tx:#161616;--tx2:#525252;--pri:#0f62fe;--lk:#0f62fe;--ok:#198038;--err:#da1e28;--fc:#0f62fe;--md:#fff;
--blue:#0043ce;--teal:#005d5d;--purple:#6929c4;--red:#a2191f;--gray:#525252;--green:#0e6027;color-scheme:light}
.dark{--bg:#161616;--l1:#262626;--l2:#393939;--bd:#393939;--tx:#f4f4f4;--tx2:#c6c6c6;--lk:#78a9ff;--ok:#42be65;--fc:#fff;--md:#262626;
--blue:#78a9ff;--teal:#08bdba;--purple:#be95ff;--red:#ff8389;--gray:#c6c6c6;--green:#42be65;color-scheme:dark}
*{box-sizing:border-box}html{scroll-padding-top:64px}
body{margin:0;background:var(--bg);color:var(--tx);font:400 14px/1.43 "IBM Plex Sans","Helvetica Neue",Arial,sans-serif;letter-spacing:.16px}
:focus-visible{outline:2px solid var(--fc);outline-offset:-2px}
code,pre,.mono,kbd{font-family:"IBM Plex Mono",Menlo,Consolas,monospace}
code{background:var(--l1);padding:1px 5px;font-size:12.5px}
kbd{background:var(--l2);padding:1px 6px;font-size:12px}
svg.ic{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:square;flex:none}
.btn{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 16px;border:1px solid transparent;background:none;color:var(--lk);font:inherit;letter-spacing:.16px;cursor:pointer;text-decoration:none}
.btn.sm{min-height:32px;padding:0 12px;font-size:13px}.btn.block{width:100%;justify-content:space-between}
.btn.pri{background:var(--pri);color:#fff}.btn.pri:hover{background:#0353e9}
.btn.ter{border-color:var(--lk)}.btn.ter:hover{background:var(--pri);border-color:var(--pri);color:#fff}
.btn.ghost:hover{background:var(--l2)}.btn.dng{color:var(--err)}.btn.red{background:var(--err);color:#fff}
.btn.icon{padding:0 8px;min-width:32px;justify-content:center}
/* encabezado */
.hd{position:sticky;top:0;z-index:30;background:#161616;color:#f4f4f4}
.hd .row{display:flex;align-items:center;height:48px}
.hd .btn{color:#f4f4f4;min-height:48px;padding:0 12px}.hd .btn:hover{background:#2c2c2c}.hd .btn.on{background:#0f62fe}
.hd h1{font-size:14px;font-weight:600;margin:0 0 0 16px;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;max-width:34vw}.hd h1 span{font-weight:400;color:#c6c6c6;margin-left:8px}
.hd .sp{flex:1}.hd .pg{font-size:13px;margin-right:8px;white-space:nowrap}
.hd .sv{position:relative}.hd .sv .dot{position:absolute;top:10px;right:4px;width:8px;height:8px;border-radius:50%;background:#f1c21b;display:none}
.hbar{height:3px;background:#393939}.hbar i{display:block;height:100%;background:#42be65;width:0;transition:width .25s}
#menu{display:none}
/* estructura */
.shell{display:flex}
.side{width:288px;flex:none;background:var(--l1);border-right:1px solid var(--bd);position:sticky;top:51px;height:calc(100vh - 51px);overflow:auto}
.pan{padding:24px 16px;border-bottom:1px solid var(--bd)}
.big{font-size:42px;font-weight:300;line-height:1.1}.big small{font-size:20px;margin-left:2px}
.mu{color:var(--tx2);font-size:12px;margin:4px 0 0}
.meter{margin-top:14px}.mh{display:flex;justify-content:space-between;font-size:12px;margin-bottom:6px}.mh b{font-weight:600}
.bar{height:4px;background:var(--l2)}.bar i{display:block;height:100%;background:var(--pri);transition:width .25s}.bar.ok i{background:var(--ok)}
.pan .btn.block{margin-top:20px}
.bk{margin-top:14px;font-size:12px;color:var(--tx2);display:flex;gap:8px;align-items:flex-start}
.bk .dot{width:8px;height:8px;border-radius:50%;background:#8d8d8d;margin-top:5px;flex:none}.bk .dot.w{background:#f1c21b}.bk .dot.g{background:var(--ok)}
.chk{display:flex;gap:8px;align-items:center;font-size:13px;cursor:pointer}.chk input{width:16px;height:16px;margin:0}
.nv{padding:8px 0}.nv button{display:flex;width:100%;align-items:center;justify-content:space-between;gap:8px;min-height:36px;padding:0 16px;background:none;border:0;border-left:3px solid transparent;color:var(--tx);font:inherit;text-align:left;cursor:pointer}
.nv button:hover{background:var(--l2)}
.nv .c{font-size:12px;color:var(--tx2);font-variant-numeric:tabular-nums;flex:none}.nv .c.ok{color:var(--ok)}
.nv button span:first-child{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.nv .n1{font-weight:600;margin-top:6px}.nv .n2{padding-left:28px;font-size:13px}.nv .n3{padding-left:44px;font-size:12.5px;color:var(--tx2)}
.nv .none{padding:8px 16px;color:var(--tx2);font-size:13px}
main{flex:1;min-width:0;padding:32px 48px 120px;max-width:1000px}
.info{border:1px solid var(--bd);background:var(--l1);padding:16px;margin-bottom:8px}
.info .lb:first-child{margin-top:0}
.fl{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.lb{display:block;font-size:12px;color:var(--tx2);margin:14px 0 4px}
textarea,select,input[type=text]{width:100%;font:inherit;color:var(--tx);background:var(--l1);border:0;border-bottom:1px solid #8d8d8d;padding:10px 16px;min-height:40px;resize:vertical;letter-spacing:.16px}
.info input[type=text]{background:var(--bg)}
.hin{background:var(--l1)!important}
.note{border-left:3px solid #f1c21b;background:var(--l1);padding:12px 16px;margin:16px 0}
.tg{display:inline-block;padding:2px 8px;border-radius:16px;font-size:12px;line-height:18px;white-space:nowrap;color:var(--c);background:color-mix(in srgb,var(--c) 16%,transparent)}
.cd{font:500 12px "IBM Plex Mono",monospace;color:var(--tx2)}
/* bloques */
.blk{padding-left:var(--ind,0px);position:relative}
.blk.flash{animation:fl 1.6s}@keyframes fl{0%,60%{background:color-mix(in srgb,var(--pri) 14%,transparent)}}
.ctl{display:flex;align-items:center;gap:4px;flex-wrap:wrap;margin:14px 0 6px;padding:4px 6px;background:var(--l1);border:1px solid var(--bd)}
.ctl select{width:auto;min-height:32px;padding:0 8px;font-size:12px;background:var(--bg)}.ctl .sp{flex:1}
.ins{display:flex;gap:6px;flex-wrap:wrap;padding:10px;background:var(--l1);border:1px dashed var(--tx2);margin:8px 0}
.addbar{position:fixed;left:288px;right:0;bottom:0;z-index:20;background:var(--bg);border-top:1px solid var(--bd);padding:8px 16px;display:flex;gap:6px;flex-wrap:wrap;align-items:center}
.addbar .mu{margin:0 6px 0 0}
.empty{border:1px dashed var(--tx2);padding:32px;text-align:center;color:var(--tx2);margin-top:24px}
.k-h1{margin-top:44px}.k-h1 .hrow{display:flex;gap:10px;align-items:baseline}
.k-h1 h3{font-size:22px;font-weight:400;margin:0;max-width:60ch}.k-h1 header{display:flex;justify-content:space-between;align-items:flex-start;gap:16px}
.k-h1 .hin{font-size:20px}.k-h1 .hrow{flex:1;min-width:0}.k-h1 .hrow .hin{flex:1}.k-h1 .cnt{font-size:13px;font-variant-numeric:tabular-nums}
.k-h1 .bar{margin:12px 0 0}
.st{display:flex;gap:12px;padding:20px 0 8px 12px;border-left:3px solid transparent}
.st.done{border-left-color:var(--ok)}.st.done h4{color:var(--tx2)}
.ck{position:relative;width:20px;height:20px;flex:none;margin-top:1px;cursor:pointer}.ck input{position:absolute;inset:0;opacity:0;margin:0;cursor:pointer}
.ck i{position:absolute;inset:2px;border:1px solid var(--tx);pointer-events:none}.ck input:checked+i{background:var(--tx)}
.ck input:checked+i::after{content:"";position:absolute;left:4px;top:0;width:4px;height:9px;border:solid var(--bg);border-width:0 2px 2px 0;transform:rotate(45deg)}
.ck input:focus-visible+i{outline:2px solid var(--fc);outline-offset:2px}
.sb{flex:1;min-width:0}.sm{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.st h4{font-size:16px;font-weight:600;margin:6px 0;line-height:1.4}.k-h3 h4{font-size:14.5px}
.txt{max-width:75ch;line-height:1.6;margin:8px 0}.txt p{margin:0 0 10px}.txt ul,.txt ol{margin:6px 0 10px;padding-left:22px}
.tbl{overflow-x:auto;margin:10px 0}table{border-collapse:collapse;width:100%;font-size:13px}th{background:var(--l1);text-align:left}th,td{padding:8px 12px;border:1px solid var(--bd);vertical-align:top}
.tx{min-height:72px;font-size:14px}.tx.mono{font-family:"IBM Plex Mono",monospace;font-size:13px}.hint{font-size:11px;color:var(--tx2);margin:2px 0 0}
.code{background:var(--l1);margin:12px 0}.code-h{display:flex;justify-content:space-between;align-items:center;padding-left:16px;font-size:12px;color:var(--tx2);border-bottom:1px solid var(--bd)}
.code pre{margin:0;padding:14px 16px;font-size:13px;line-height:1.6;white-space:pre-wrap;overflow-wrap:anywhere}.code pre code{background:none;padding:0;font-size:inherit}
.ev{border:1px solid var(--bd);padding:16px;margin-top:10px}.ev.has{border-color:var(--ok)}.ev.act{outline:2px solid var(--pri);outline-offset:1px}
.evh{display:flex;justify-content:space-between;gap:8px;align-items:center;flex-wrap:wrap}
.capt{margin:10px 0;font-weight:600}
.zone{border:1px dashed var(--tx2);padding:20px;text-align:center;outline-offset:-3px}
.zone.over,.zone:focus{background:color-mix(in srgb,var(--pri) 10%,transparent);border-color:var(--pri)}.zone p{margin:8px 0 12px}
.acts{display:flex;gap:4px;align-items:center;flex-wrap:wrap;justify-content:center;margin-top:6px}.has .acts{justify-content:flex-start}
.shot{display:block;max-width:100%;max-height:300px;border:1px solid var(--bd);cursor:zoom-in;margin-top:8px}
.q{padding:16px 0 8px;margin-top:8px}.q h4{margin:8px 0;font-size:16px;font-weight:600;max-width:70ch;line-height:1.4}
/* inicio */
.start{position:fixed;inset:0;background:var(--bg);z-index:40;overflow:auto;display:none}.start.on{display:block}
.start-in{max-width:1000px;margin:0 auto;padding:40px 24px 64px;position:relative}
.start h1{font-size:34px;font-weight:300;margin:6px 0 8px;line-height:1.2}.kick{font-size:12px;font-weight:600;letter-spacing:.14em;text-transform:uppercase;color:var(--lk)}
.lead{max-width:70ch;line-height:1.6;font-size:15px;margin:0 0 24px}
.opts{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:2px;margin-top:24px;background:var(--bd)}
.opt{background:var(--l1);padding:20px 16px;display:flex;flex-direction:column;gap:10px;border-top:3px solid var(--pri)}.opt.over{background:color-mix(in srgb,var(--pri) 12%,var(--l1))}
.opt h3{margin:0;font-size:18px;font-weight:400}.opt p{margin:0;color:var(--tx2);flex:1}.opt .acts{justify-content:flex-start;margin:0}
.acc{border-top:1px solid var(--bd);border-bottom:1px solid var(--bd);margin:28px 0}.acc summary{min-height:48px;display:flex;align-items:center;cursor:pointer;font-weight:600}.acc>div{padding:0 0 16px}
/* modales y toasts */
.ov{position:fixed;inset:0;background:rgba(22,22,22,.6);display:none;align-items:center;justify-content:center;z-index:50;padding:16px}.ov.on{display:flex}
.md{background:var(--md);width:100%;max-width:560px;max-height:92vh;overflow:auto;display:flex;flex-direction:column;position:relative}
.md.wide{max-width:1000px}.md h2{margin:0;padding:16px 56px 0 16px;font-size:20px;font-weight:400}.mb{padding:16px;display:grid;gap:16px}
.mf{display:flex;justify-content:flex-end;margin-top:8px}.mf .btn{min-width:140px;min-height:64px;align-items:flex-start;padding-top:16px}
.x{position:absolute;right:0;top:0}
.rt{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}.rt label{border:1px solid var(--bd);padding:12px;cursor:pointer;display:grid;gap:2px}
.rt label:has(input:checked){border:2px solid var(--pri);padding:11px}.rt input{position:absolute;opacity:0}.rt b{font-weight:600}.rt span{font-size:12px;color:var(--tx2)}
.toasts{position:fixed;right:16px;bottom:72px;display:grid;gap:8px;z-index:60}
.toast{background:var(--tx);color:var(--bg);border-left:3px solid var(--c,#4589ff);padding:12px 16px;min-width:240px;max-width:380px;box-shadow:0 2px 6px rgba(0,0,0,.3);display:flex;gap:12px;align-items:center;justify-content:space-between}
.toast button{background:none;border:0;color:var(--bg);text-decoration:underline;cursor:pointer;font:inherit}
@media(max-width:1055px){#menu{display:inline-flex}.side{position:fixed;left:0;top:51px;z-index:25;transform:translateX(-100%);transition:transform .2s;width:300px}.side.open{transform:none}
main{padding:24px 16px 140px}.hd .lbl{display:none}.hd h1 span{display:none}.fl,.rt{grid-template-columns:1fr}.addbar{left:0}}
@media(prefers-reduced-motion:reduce){*{animation:none!important;transition:none!important}}
</style>
</head>
<body>
<header class="hd">
  <div class="row">
    <button class="btn" id="menu" aria-label="Abrir navegación" onclick="$('#side').classList.toggle('open')"></button>
    <h1 id="hd-title">Framework de prácticas<span>Packet Tracer</span></h1>
    <div class="sp"></div>
    <span class="pg" id="hp"></span>
    <button class="btn" id="b-edit" onclick="toggleEdit()" title="Añadir, editar y reordenar la estructura"><span class="lbl">Editar estructura</span></button>
    <button class="btn" id="b-tpl" onclick="$('#tpl-file').click()" title="Cargar plantilla Markdown (.md)"><span class="lbl">Plantilla</span></button>
    <button class="btn sv" id="b-save" onclick="saveProgress()" title="Guardar progreso (Ctrl+S)"><span class="dot" id="sdot"></span><span class="lbl">Guardar</span></button>
    <button class="btn" id="b-load" onclick="$('#imp').click()" title="Cargar progreso desde un .json"><span class="lbl">Cargar</span></button>
    <button class="btn" id="b-exp" onclick="openExport()" title="Exportar reporte (Ctrl+E)"><span class="lbl">Reporte</span></button>
    <button class="btn" id="b-th" onclick="toggleTheme()" title="Cambiar tema"></button>
    <button class="btn" id="b-home" onclick="showStart()" title="Pantalla de inicio"></button>
  </div>
  <div class="hbar"><i id="hbar"></i></div>
</header>
<input type="file" id="tpl-file" accept=".md,.markdown,.txt,text/markdown,text/plain" hidden onchange="onTplInput(event)">
<input type="file" id="imp" accept=".json,application/json" hidden onchange="onJsonInput(event)">
<input type="file" id="add-imgs" accept="image/*" multiple hidden onchange="addFiles(this)">
<div class="shell"><aside class="side" id="side"></aside><main id="main"></main></div>
<div class="addbar" id="addbar" style="display:none"></div>

<!-- pantalla de inicio -->
<div class="start on" id="start"><div class="start-in">
  <button class="btn x" id="st-x" onclick="hideStart()" aria-label="Volver a la práctica" style="display:none"></button>
  <div class="kick">Framework · Cisco Packet Tracer</div>
  <h1>Documenta tu práctica de Packet Tracer</h1>
  <p class="lead">Crea un reporte desde cero e ve agregando secciones, pasos, preguntas, texto e imágenes, o parte de una plantilla Markdown y solo sube tus evidencias. Al final exportas el reporte en HTML, Markdown o PDF.</p>
  <div class="info">
    <label class="lb" for="s-title">Nombre de la práctica</label><input type="text" id="s-title" placeholder="Ej. Configuración de DHCPv4 con relay">
    <div class="fl"><div><label class="lb" for="s-name">Tu nombre (opcional aquí)</label><input type="text" id="s-name" autocomplete="name"></div><div><label class="lb" for="s-group">Grupo / materia (opcional)</label><input type="text" id="s-group"></div></div>
  </div>
  <div class="opts">
    <div class="opt"><h3>Reporte en blanco</h3><p>Empiezas vacío y añades tú mismo secciones (#), pasos (##), sub-pasos (###), preguntas (####), texto, comandos e imágenes.</p><div class="acts"><button class="btn pri" onclick="startBlank()">Crear en blanco</button></div></div>
    <div class="opt" id="o-tpl" ondragover="dragO(event,1)" ondragleave="dragO(event,0)" ondrop="dropO(event)"><h3>Usar una plantilla (.md)</h3><p>Sube un Markdown con la estructura de la práctica y aparecerá lista para marcar pasos, responder y subir capturas. También puedes arrastrar el archivo aquí.</p><div class="acts"><button class="btn pri" onclick="$('#tpl-file').click()">Subir plantilla</button><button class="btn ghost sm" onclick="useSample()">Probar con ejemplo</button><button class="btn ghost sm" onclick="downloadSample()">Descargar ejemplo</button><button class="btn ghost sm" onclick="downloadGuide()" title="Archivo .md con las reglas del formato, para dárselo a una IA">Guía de formato para IA</button></div></div>
    <div class="opt"><h3>Cargar progreso (.json)</h3><p>Retoma una práctica que guardaste antes, con sus avances, respuestas e imágenes.</p><div class="acts"><button class="btn ter" onclick="$('#imp').click()">Subir .json</button></div></div>
    <div class="opt" id="o-cont" style="display:none"><h3>Continuar</h3><p id="o-cont-t"></p><div class="acts"><button class="btn ter" onclick="hideStart()">Seguir con esta práctica</button></div></div>
  </div>
  <details class="acc"><summary>Formato de la plantilla Markdown</summary><div>
    <div class="tbl"><table><thead><tr><th>En el .md</th><th>Aparece como</th></tr></thead><tbody>
    <tr><td><code># Título</code></td><td>Sección (con barra de avance)</td></tr>
    <tr><td><code>## Título</code></td><td>Paso (con casilla de completado)</td></tr>
    <tr><td><code>### Título</code></td><td>Sub-paso (con casilla)</td></tr>
    <tr><td><code>#### Pregunta</code></td><td>Pregunta con cuadro de respuesta (las líneas <code>&gt; …</code> siguientes se toman como respuesta)</td></tr>
    <tr><td>Texto, listas, tablas</td><td>Texto normal (admite <code>**negrita**</code>, <code>`código`</code>, listas y tablas Markdown)</td></tr>
    <tr><td>Bloque con tres comillas invertidas</td><td>Bloque de comandos con botón «Copiar»</td></tr>
    <tr><td><code>![Descripción de la captura](x)</code> o <code>[IMAGEN: Descripción]</code></td><td>Espacio para subir o pegar esa evidencia</td></tr>
    <tr><td>Encabezado <code>---</code> al inicio con <code>titulo:</code>, <code>estudiante:</code>, <code>grupo:</code></td><td>Rellena los datos de la práctica (opcional)</td></tr>
    </tbody></table></div></div></details>
</div></div>

<!-- lightbox -->
<div class="ov" id="lb-ov" onclick="if(event.target===this)closeOv('lb-ov')"><div class="md wide"><button class="btn x" onclick="closeOv('lb-ov')" aria-label="Cerrar" id="lb-x"></button><h2 id="lb-t"></h2>
  <div class="mb"><img id="lb-img" alt="" style="max-width:100%;max-height:70vh;margin:auto"><div style="margin:0"><button class="btn ter sm" id="lb-dl">Descargar</button></div></div></div></div>

<!-- exportar -->
<div class="ov" id="export-modal" onclick="if(event.target===this)closeOv('export-modal')"><div class="md"><button class="btn x" onclick="closeOv('export-modal')" aria-label="Cerrar" id="ex-x"></button><h2>Exportar reporte</h2>
  <div class="mb">
    <div class="rt"><label><input type="radio" name="exp-format" value="html" checked><b>HTML</b><span>Autocontenido</span></label><label><input type="radio" name="exp-format" value="md"><b>Markdown</b><span>.zip con imágenes</span></label><label><input type="radio" name="exp-format" value="pdf"><b>PDF</b><span>Diálogo de impresión</span></label></div>
    <div><label class="lb" for="export-theme" style="margin-top:0">Estilo visual del reporte</label><select id="export-theme"></select></div>
    <div><label class="lb" for="ex-title" style="margin-top:0">Nombre de la práctica</label><input type="text" id="ex-title"></div>
    <div class="fl"><div><label class="lb" for="ex-name" style="margin-top:0">Estudiante / equipo</label><input type="text" id="ex-name"></div><div><label class="lb" for="ex-group" style="margin-top:0">Matrícula / grupo / materia</label><input type="text" id="ex-group"></div></div>
    <p class="mu" id="export-summary-pill"></p></div>
  <div class="mf"><button class="btn ghost" onclick="closeOv('export-modal')">Cancelar</button><button class="btn pri" onclick="runExport()">Generar reporte</button></div></div></div>

<!-- confirmación -->
<div class="ov" id="cf-ov"><div class="md"><h2 id="cf-t"></h2><div class="mb"><p id="cf-m" style="margin:0"></p></div>
  <div class="mf"><button class="btn ghost" onclick="closeOv('cf-ov')">Cancelar</button><button class="btn red" id="cf-ok"></button></div></div></div>
<div class="toasts" id="toasts" aria-live="polite"></div>

<script>
/* ================= utilidades ================= */
const $=s=>document.querySelector(s),$$=s=>[...document.querySelectorAll(s)];
