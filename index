const KEY='pt_framework_doc_v1',META='pt_framework_meta',DBN='PTFramework_DB';
const TYPES=[['h1','Sección','#'],['h2','Paso','##'],['h3','Sub-paso','###'],['q','Pregunta','####'],['p','Texto','¶'],['img','Imagen',''],['code','Comandos','</>']];
const TNAME={h1:'Sección (#)',h2:'Paso (##)',h3:'Sub-paso (###)',q:'Pregunta (####)',p:'Texto',img:'Imagen',code:'Comandos'};
const LV={h1:1,h2:2,h3:3};
let doc=null,images={},meta={backupAt:null,dirty:false},db=null,edit=false,active=null,lastPos=null,insertFor=null,focusId=null,reveal=null,undoStack=[];
const mk=(t,o)=>({id:uid(),t,text:'',cap:'',note:'',ans:'',done:false,lang:'',...o});
const get=id=>doc.blocks.find(b=>b.id===id),idx=id=>doc.blocks.findIndex(b=>b.id===id);
const pctOf=(a,b)=>b?Math.round(a/b*100):0;
const tag=(t,k)=>`<span class="tg" style="--c:var(--${k||'blue'})">${E(t)}</span>`;
const meter=(l,a,b)=>`<div class="meter"><div class="mh"><span>${l}</span><b>${a}/${b}</b></div><div class="bar${a&&a===b?' ok':''}"><i style="width:${pctOf(a,b)}%"></i></div></div>`;
const trk=b=>b.t==='h2'||b.t==='h3'?[1,!!b.done]:b.t==='img'?[1,!!images[b.id]]:b.t==='q'?[1,!!(b.ans||'').trim()]:[0,0];
function stats(){const s={st:0,sd:0,et:0,ed:0,qt:0,qd:0};doc.blocks.forEach(b=>{
  if(b.t==='h2'||b.t==='h3'){s.st++;if(b.done)s.sd++}else if(b.t==='img'){s.et++;if(images[b.id])s.ed++}else if(b.t==='q'){s.qt++;if((b.ans||'').trim())s.qd++}});
  s.T=s.st+s.et+s.qt;s.D=s.sd+s.ed+s.qd;s.pct=pctOf(s.D,s.T);return s}
function grp(){const r={};let cur=null;doc.blocks.forEach(b=>{if(b.t==='h1'){cur=b.id;r[cur]=[0,0]}else if(cur){const[t,d]=trk(b);if(t){r[cur][1]++;if(d)r[cur][0]++}}});return r}
function nums(){const lab={},ev={};let a=0,b2=0,c=0,q=0,im=0;doc.blocks.forEach(x=>{
  if(x.t==='h1'){a++;b2=0;c=0}else if(x.t==='h2'){b2++;c=0}else if(x.t==='h3')c++;
  if(LV[x.t])lab[x.id]=doc.numbering?[a,b2,c].slice(0,LV[x.t]).filter(n=>n>0).join('.'):'';
  else if(x.t==='q'){q++;lab[x.id]=doc.numbering?'P'+q+'.':''}
  else if(x.t==='img'){im++;ev[x.id]='E'+String(im).padStart(2,'0')}});return{lab,ev}}
const slug=s=>String(s||'').normalize('NFD').replace(/[\u0300-\u036f]/g,'').toLowerCase().replace(/[^a-z0-9]+/g,'-').replace(/^-|-$/g,'').slice(0,40);

