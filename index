async function copyCode(id,btn){const t=get(id).text;let ok=false;try{if(navigator.clipboard&&window.isSecureContext){await navigator.clipboard.writeText(t);ok=true}}catch(e){}
  if(!ok){const ta=document.createElement('textarea');ta.value=t;ta.style.cssText='position:fixed;opacity:0';document.body.appendChild(ta);ta.select();try{ok=document.execCommand('copy')}catch(e){}ta.remove()}
  const l=btn.querySelector('span');const o=l.textContent;l.textContent=ok?'¡Copiado!':'No se pudo copiar';setTimeout(()=>l.textContent=o,1600)}
function evHtml(b,ctx){const r=images[b.id],id=ctx.ev[b.id],file=`<input type="file" accept="image/*" multiple hidden onchange="pickFile('${b.id}',this)">`;
  return`<div class="ev${r?' has':''}${active===b.id?' act':''}"><div class="evh"><div><span class="cd">${id}</span></div>${tag(r?'Completada':'Pendiente',r?'green':'gray')}</div>
