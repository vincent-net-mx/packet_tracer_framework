@media(max-width:640px){.body{padding:4px 18px 0}.h{padding:26px 20px 20px}}`;
const REPORT_EXTRA=`h3{font-family:var(--head);font-size:17px;margin:24px 0 8px}h4{font-family:var(--head);font-size:15px;margin:18px 0 6px}.num{color:var(--accent);font-family:ui-monospace,Consolas,monospace;font-size:.85em}
.txt{margin:8px 0}.txt p{margin:0 0 10px}.txt ul,.txt ol{padding-left:22px;margin:6px 0 10px}.txt .tbl{overflow-x:auto;margin:10px 0}code{font-family:ui-monospace,Consolas,monospace;background:var(--soft);padding:1px 5px;font-size:.9em}
pre.cmd{background:var(--soft);border:1px solid var(--line);border-left:4px solid var(--accent);padding:10px 12px;margin:10px 0;font-size:12px;white-space:pre-wrap;overflow-wrap:anywhere;font-family:ui-monospace,Consolas,monospace}pre.cmd code{background:none;padding:0}
.cmdl{font-size:11px;font-weight:700;color:var(--muted);margin:10px 0 -6px;letter-spacing:.06em;text-transform:uppercase}
@media print{h3{margin:14px 0 6px;font-size:14px;break-after:avoid}h4{break-after:avoid}pre.cmd{break-inside:avoid}}`;
function reportCss(th){return`:root{${Object.entries(th.v).map(([k,x])=>`--${k}:${x}`).join(';')}}\n`+REPORT_BASE+REPORT_EXTRA}
function bodyHtml(d){const e=E;let out='';
  const evs=d.items.filter(i=>i.b.t==='img');
  if(evs.length)out+=`<h2>Resumen de evidencias</h2><table><thead><tr><th>ID</th><th>Sección</th><th>Descripción</th><th>Estado</th></tr></thead><tbody>${evs.map(i=>`<tr><td class="mono"><b>${i.ev}</b></td><td>${e(i.sec)}</td><td>${inl(i.b.cap)||'—'}</td><td class="${i.img?'ok':'pend'}">${i.img?'Completada':'Pendiente'}</td></tr>`).join('')}</tbody></table>`;
  d.items.forEach(({b,lab,ev,img})=>{const T=(lab?`<span class="num">${e(lab)}</span> `:'')+e(b.text),ck=b.done?' <span class="ok" title="Completado">✓</span>':'';
    if(b.t==='h1')out+=`<h2>${T}</h2>`;else if(b.t==='h2')out+=`<h3>${T}${ck}</h3>`;else if(b.t==='h3')out+=`<h4>${T}${ck}</h4>`;
    else if(b.t==='p'){if(b.text.trim())out+=`<div class="txt">${md(b.text)}</div>`}
    else if(b.t==='code')out+=(b.lang?`<div class="cmdl">${e(b.lang)}</div>`:'')+`<pre class="cmd"><code>${e(b.text)}</code></pre>`;
    else if(b.t==='img')out+=`<div class="card"><div class="card-top"><div><span class="tag">${ev}</span></div><span class="pill">Evidencia</span></div>${b.cap?`<h3 style="margin-top:0">${inl(b.cap)}</h3>`:''}${img?`<div class="shot"><img src="${img.dataUrl}" alt="${e(b.cap||ev)}"/>${img.updatedAt?`<small>Capturado: ${e(img.updatedAt)}</small>`:''}</div>`:'<div class="empty">[Evidencia pendiente de captura]</div>'}${b.note.trim()?`<div class="note"><b>Observación técnica:</b> ${e(b.note.trim()).replace(/\n/g,'<br>')}</div>`:''}</div>`;
    else if(b.t==='q')out+=`<div class="card"><h3 style="margin-top:0">${lab?`<span class="num">${e(lab)}</span> `:''}${inl(b.text)}</h3><div class="ans">${b.ans.trim()?e(b.ans.trim()).replace(/\n/g,'<br>'):'<em class="muted">Sin respuesta registrada.</em>'}</div></div>`});
  return out}
function buildHtml(d,th,lay){const e=E,s=d.st;
  return`<!DOCTYPE html>\n<html lang="es"><head><meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />\n<title>${e(d.title)}</title><meta name="generator" content="Framework Packet Tracer · estilo ${e(th.name)}" />\n<style>${reportCss(th)}</style></head>
<body class="h-${lay.head} c-${lay.card}"><div class="wrap t-${lay.table}">
  <header class="h"><div class="kick">Reporte de práctica • Cisco Packet Tracer</div><h1>${e(d.title)}</h1>
    <div class="meta">${d.student?`<span><b>Estudiante / Equipo:</b> ${e(d.student)}</span>`:''}${d.group?`<span><b>Grupo / Materia:</b> ${e(d.group)}</span>`:''}<span><b>Fecha:</b> ${e(d.nowStr)}</span></div>
    <div class="chips">${s.st?`<span class="chip">Pasos: ${s.sd} / ${s.st}</span>`:''}${s.et?`<span class="chip">Evidencias: ${s.ed} / ${s.et}</span>`:''}${s.qt?`<span class="chip">Preguntas: ${s.qd} / ${s.qt}</span>`:''}</div></header>
  <div class="body">${bodyHtml(d)}<footer>Estilo visual: ${e(th.name)} · Generado el ${e(d.nowStr)}</footer></div>
</div></body></html>`}
function buildMd(d,imgRef){const one=s=>String(s||'').replace(/\s*\n\s*/g,' ').trim(),quote=s=>s.split('\n').map(l=>'> '+l).join('\n');
  const L=['---',`titulo: ${one(d.title)}`,`estudiante: ${one(d.student)}`,`grupo: ${one(d.group)}`,`fecha: ${d.nowStr}`,'---',''];
  d.items.forEach(({b,lab,ev,img})=>{const pre=lab?lab+' ':'';
    if(b.t==='h1'&&b.text.trim())L.push('# '+pre+one(b.text),'');else if(b.t==='h2'&&b.text.trim())L.push('## '+pre+one(b.text),'');else if(b.t==='h3'&&b.text.trim())L.push('### '+pre+one(b.text),'');
    else if(b.t==='p'){if(b.text.trim())L.push(b.text.trim(),'')}
    else if(b.t==='code'){const f=b.text.includes('```')?'~~~':'```';L.push(f+(b.lang||'').replace(/\s+/g,'-'),b.text,f,'')}
    else if(b.t==='img'){const cap=(b.cap||ev).replace(/[\[\]]/g,'');L.push(img?`![${cap}](${imgRef(b,img,ev)})`:`_[Evidencia pendiente: ${cap}]_`,'');if(b.note.trim())L.push(quote('**Observación técnica:** '+b.note.trim()),'')}
    else if(b.t==='q'){L.push('#### '+pre+one(b.text),'',quote(b.ans.trim()||'_Sin respuesta registrada._'),'')}});
  return L.join('\n')}
async function exportMd(d){const base='Reporte-'+(slug(d.title)||'practica');
  if(!window.JSZip){downloadBlob(new Blob([buildMd(d,(b,r)=>r.dataUrl)],{type:'text/markdown;charset=utf-8'}),base+'.md');showToast('JSZip no cargó (¿sin internet?): .md con imágenes incrustadas en base64.','info');return}
  const zip=new JSZip(),names={};d.items.forEach(({b,img,ev})=>{if(b.t==='img'&&img)names[b.id]=`images/${ev}-${slug(b.cap)||'captura'}.${imgExt(img)}`});
  zip.file(base+'.md',buildMd(d,b=>names[b.id]));d.items.forEach(({b,img})=>{if(img&&names[b.id])zip.file(names[b.id],img.dataUrl.split(',')[1],{base64:true})});
  downloadBlob(await zip.generateAsync({type:'blob'}),base+'.zip')}
function printPdf(d,th,lay){const fr=document.createElement('iframe');fr.style.cssText='position:fixed;right:0;bottom:0;width:0;height:0;border:0;visibility:hidden';document.body.appendChild(fr);
  fr.onload=()=>{const w=fr.contentWindow;Promise.all([...w.document.images].map(i=>i.complete?1:new Promise(r=>{i.onload=i.onerror=r}))).then(()=>{const ot=document.title;document.title='Reporte-'+(slug(d.title)||'practica');
    w.addEventListener('afterprint',()=>{document.title=ot;setTimeout(()=>fr.remove(),500)});w.focus();w.print()})};fr.srcdoc=buildHtml(d,th,lay)}
async function runExport(){const fmt=(document.querySelector('input[name="exp-format"]:checked')||{}).value||'html';
  try{const d=collect(),{theme,lay}=chooseStyle();
    if(fmt==='html')downloadBlob(new Blob([buildHtml(d,theme,lay)],{type:'text/html;charset=utf-8'}),'Reporte-'+(slug(d.title)||'practica')+'.html');else if(fmt==='md')await exportMd(d);else printPdf(d,theme,lay);
    closeOv('export-modal');showToast(fmt==='md'?'Markdown exportado.':`Reporte ${fmt.toUpperCase()} listo · estilo «${theme.name}»`,'success')}catch(err){console.error(err);showToast('No se pudo generar el reporte.','error')}}

