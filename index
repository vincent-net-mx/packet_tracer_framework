document.addEventListener('keydown',e=>{const k=e.key.toLowerCase();
  if((e.ctrlKey||e.metaKey)&&k==='e'){e.preventDefault();openExport()}
  else if((e.ctrlKey||e.metaKey)&&k==='s'){e.preventDefault();saveProgress()}
  else if((e.ctrlKey||e.metaKey)&&k==='z'&&!/^(TEXTAREA|INPUT)$/.test(document.activeElement.tagName)&&edit){e.preventDefault();undo()}
  else if(k==='escape'){$$('.ov.on').forEach(o=>o.classList.remove('on'))}});
window.addEventListener('DOMContentLoaded',async()=>{loadLocal();try{await initDB();for(const r of(await idb('readonly',s=>s.getAll())||[]))await putImg(r)}catch(e){}
  if(doc){render();$('#start').classList.remove('on')}else showStart()});
