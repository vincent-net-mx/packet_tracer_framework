  ${r?`<img class="shot" src="${r.url}" alt="${E(b.cap||id)}" onclick="openLb('${b.id}')"><div class="acts"><button class="btn ghost sm" onclick="openLb('${b.id}')">Ampliar</button><button class="btn ghost sm" onclick="downloadImg('${b.id}')">Descargar</button><label class="btn ghost sm">Reemplazar${file}</label><button class="btn ghost sm dng" onclick="rmImg('${b.id}')">Quitar</button><span class="mu">${E(r.updatedAt||'')}</span></div>`
  :`<div class="zone" tabindex="0" ondrop="dropImg('${b.id}',event)" ondragover="dragZ(event,1)" ondragleave="dragZ(event,0)">${ic('img')}<p>Arrastra tu captura aquí, o haz clic y pega con <kbd>Ctrl</kbd> + <kbd>V</kbd></p><div class="acts"><label class="btn ter sm">Seleccionar imagen(es)${file}</label><button class="btn ghost sm" onclick="pasteBtn('${b.id}')">Pegar del portapapeles</button></div></div>`}
  <label class="lb">Observación técnica (opcional, se incluye en el reporte)</label><textarea class="tx auto" rows="2" oninput="setF('${b.id}','note',this.value);ar(this)">${E(b.note)}</textarea></div>`}
function blockHtml(b,ctx){const lab=ctx.lab[b.id]||'',ind=ctx.ind[b.id]||0;let h='';
  const ctl=edit?`<div class="ctl"><select onchange="setType('${b.id}',this.value)" aria-label="Tipo de bloque">${Object.keys(TNAME).map(t=>`<option value="${t}"${t===b.t?' selected':''}>${TNAME[t]}</option>`).join('')}</select><span class="sp"></span>
    <button class="btn ghost sm icon" onclick="mv('${b.id}',-1)" title="${LV[b.t]?'Subir (con su contenido)':'Subir'}">${ic('up')}</button><button class="btn ghost sm icon" onclick="mv('${b.id}',1)" title="${LV[b.t]?'Bajar (con su contenido)':'Bajar'}">${ic('down')}</button>
    <button class="btn ter sm" onclick="toggleIns('${b.id}')">${ic('plus')} Insertar debajo</button><button class="btn ghost sm icon dng" onclick="delBlock('${b.id}')" title="Eliminar bloque">${ic('trash')}</button></div>`:'';
  const hin=(ph)=>`<input type="text" class="hin" value="${E(b.text)}" placeholder="${ph}" oninput="setF('${b.id}','text',this.value)">`;
  if(b.t==='h1')h=`<section class="k-h1"><header><div class="hrow">${lab?`<span class="cd">${E(lab)}</span>`:''}${edit?hin('Título de la sección'):`<h3>${E(b.text)||'<em>Sin título</em>'}</h3>`}</div><span class="cnt" data-cnt="${b.id}"></span></header><div class="bar" data-bar="${b.id}"><i></i></div></section>`;
  else if(b.t==='h2'||b.t==='h3'){const d=!!b.done;h=`<article class="st k-${b.t}${d?' done':''}"><label class="ck"><input type="checkbox"${d?' checked':''} onchange="toggleDone('${b.id}',this.checked)" aria-label="Completar"><i></i></label><div class="sb"><div class="sm">${lab?`<span class="cd">${b.t==='h2'?'Paso':'Sub-paso'} ${E(lab)}</span>`:`<span class="cd">${b.t==='h2'?'Paso':'Sub-paso'}</span>`}</div>${edit?hin(b.t==='h2'?'Título del paso':'Título del sub-paso'):`<h4>${E(b.text)||'<em>Sin título</em>'}</h4>`}</div></article>`}
  else if(b.t==='q')h=`<div class="q"><div class="sm"><span class="cd">${E(lab||'Pregunta')}</span>${tag('Pregunta','purple')}</div>${edit?hin('Escribe la pregunta'):`<h4>${inl(b.text)||'<em>Sin enunciado</em>'}</h4>`}<textarea class="tx auto" rows="4" placeholder="Redacta tu respuesta…" oninput="setF('${b.id}','ans',this.value);ar(this)">${E(b.ans)}</textarea></div>`;
  else if(b.t==='p')h=edit?`<textarea class="tx auto" rows="3" placeholder="Texto normal (admite Markdown: **negrita**, \`código\`, listas y tablas)" oninput="setF('${b.id}','text',this.value);ar(this)">${E(b.text)}</textarea><p class="hint">Admite Markdown: **negrita**, \`código\`, listas y tablas.</p>`:(b.text.trim()?`<div class="txt">${md(b.text)}</div>`:'');
  else if(b.t==='code')h=edit?`<label class="lb">Etiqueta (opcional, ej. «R1», «Switch», «PC0»)</label><input type="text" class="hin" value="${E(b.lang)}" oninput="setF('${b.id}','lang',this.value)"><textarea class="tx mono auto" rows="4" placeholder="Comandos o salida de consola" oninput="setF('${b.id}','text',this.value);ar(this)" style="margin-top:6px">${E(b.text)}</textarea>`:codeHtml(b);
  else if(b.t==='img')h=evHtml(b,ctx);
  return`<div class="blk" id="${b.id}" data-b="${b.id}" style="--ind:${ind}px">${ctl}${h}${insertFor===b.id?insBar(b.id):''}</div>`}
function mainHtml(){const n=nums(),ctx={lab:n.lab,ev:n.ev,ind:{}};let cur=0;
  doc.blocks.forEach(b=>{if(b.t==='h1'){cur=0;ctx.ind[b.id]=0}else if(b.t==='h2'){cur=32;ctx.ind[b.id]=0}else if(b.t==='h3'){cur=64;ctx.ind[b.id]=32}else ctx.ind[b.id]=cur});
  const info=`<div class="info"><label class="lb" for="i-title">Nombre de la práctica</label><input type="text" id="i-title" value="${E(doc.title)}" placeholder="Ej. Configuración de DHCPv4 con relay" oninput="setDoc('title',this.value)">
    <div class="fl"><div><label class="lb" for="i-name">Estudiante / equipo</label><input type="text" id="i-name" value="${E(doc.student)}" oninput="setDoc('student',this.value)"></div><div><label class="lb" for="i-group">Matrícula / grupo / materia</label><input type="text" id="i-group" value="${E(doc.group)}" oninput="setDoc('group',this.value)"></div></div></div>`;
  const body=doc.blocks.length?doc.blocks.map(b=>blockHtml(b,ctx)).join(''):`<div class="empty"><p><b>La práctica está vacía.</b></p><p>Usa los botones de abajo para añadir una sección, un paso, texto o una imagen.<br>También puedes pegar una captura con <kbd>Ctrl</kbd> + <kbd>V</kbd> y se creará un bloque de imagen.</p>${edit?'':'<p><button class="btn ter" onclick="toggleEdit()">Editar estructura</button></p>'}</div>`;
  const hint=edit?`<div class="note"><b>Modo edición.</b> Cambia el tipo de cada bloque, reordénalo (las flechas mueven un título junto con su contenido), inserta bloques debajo o elimínalo. Al terminar pulsa «Terminar edición».</div>`:'';
