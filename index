function snap(){undoStack.push(JSON.stringify(doc.blocks));if(undoStack.length>40)undoStack.shift()}
function undo(){if(!undoStack.length)return showToast('No hay nada que deshacer.','info');doc.blocks=JSON.parse(undoStack.pop());dirty();render()}
function toggleEdit(){edit=!edit;insertFor=null;render()}
function toggleIns(id){insertFor=insertFor===id?null:id;render()}
function addBlock(t,after){snap();const b=mk(t),i=after?idx(after)+1:doc.blocks.length;doc.blocks.splice(i,0,b);insertFor=null;edit=true;focusId=b.id;dirty();render()}
function delBlock(id){snap();const b=get(id);doc.blocks.splice(idx(id),1);insertFor=null;dirty();render();showToast('Bloque eliminado.','info',{label:'Deshacer',fn:undo})}
function setType(id,t){snap();const b=get(id);if(b.t==='img'&&t!=='img')b.text=b.cap||b.text;if(t==='img')b.cap=b.text||b.cap;b.t=t;dirty();render()}
function setF(id,f,v){const b=get(id);if(b){b[f]=v;dirty()}}
function setDoc(f,v){doc[f]=v;dirty()}
function setNum(v){doc.numbering=v;dirty();render()}
function toggleDone(id,v){const b=get(id);b.done=v;const e=document.getElementById(id);if(e){const s=e.querySelector('.st');if(s)s.classList.toggle('done',v)}dirty()}
function range(i){const L=LV[doc.blocks[i].t];if(!L)return[i,i+1];let e=i+1;while(e<doc.blocks.length&&!(LV[doc.blocks[e].t]&&LV[doc.blocks[e].t]<=L))e++;return[i,e]}
function mv(id,dir){const i=idx(id),[s,e]=range(i),L=LV[doc.blocks[i].t],B=doc.blocks;let ok=false;snap();
  if(dir<0){if(s>0){if(!L){const x=B.splice(s,1)[0];B.splice(s-1,0,x);ok=true}else{let ns=-1;for(let p=s-1;p>=0;p--){const l=LV[B[p].t];if(l&&l<L)break;if(l===L){ns=p;break}}
      if(ns>=0){const seg=B.splice(s,e-s);B.splice(ns,0,...seg);ok=true}}}}
  else if(e<B.length){if(!L){const x=B.splice(e,1)[0];B.splice(s,0,x);ok=true}else{const nl=LV[B[e].t];if(!(nl&&nl<L)){const[s2,e2]=range(e);const seg=B.splice(s2,e2-s2);B.splice(s,0,...seg);ok=true}}}
  if(!ok){undoStack.pop();return showToast('No se puede mover más en esa dirección.','info')}
  reveal=id;dirty();render()}

