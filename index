const EXPORT_LAYOUTS={head:['banner','rule','center'],card:['box','flat','shadow'],table:['zebra','lines']};
const pickRandom=a=>a[Math.floor(Math.random()*a.length)];
function openExport(){if(!doc)return;$('#ex-title').value=doc.title||'';$('#ex-name').value=doc.student||'';$('#ex-group').value=doc.group||'';const sel=$('#export-theme');
  if(!sel.options.length)sel.innerHTML='<option value="random">Aleatorio (distinto en cada reporte)</option>'+REPORT_THEMES.map(t=>`<option value="${t.id}">${t.name}</option>`).join('');
  const s=stats();$('#export-summary-pill').textContent=`Incluye ${s.sd}/${s.st} pasos completados, ${s.ed}/${s.et} evidencias y ${s.qd}/${s.qt} preguntas respondidas.`;openOv('export-modal')}
function chooseStyle(){const sel=$('#export-theme').value;let theme,lay;
  if(sel==='random'){let last='';try{last=localStorage.getItem('pt_last_theme')||''}catch(e){}theme=pickRandom(REPORT_THEMES.filter(t=>t.id!==last));lay={head:pickRandom(EXPORT_LAYOUTS.head),card:pickRandom(EXPORT_LAYOUTS.card),table:pickRandom(EXPORT_LAYOUTS.table)}}
  else{theme=REPORT_THEMES.find(t=>t.id===sel)||REPORT_THEMES[0];lay={head:'banner',card:'box',table:'zebra'}}
  try{localStorage.setItem('pt_last_theme',theme.id)}catch(e){}return{theme,lay}}
function collect(){doc.title=$('#ex-title').value.trim();doc.student=$('#ex-name').value.trim();doc.group=$('#ex-group').value.trim();persistDoc();hdr();
  const n=nums();let sec='';const items=doc.blocks.map(b=>{if(b.t==='h1')sec=b.text;return{b,lab:n.lab[b.id]||'',ev:n.ev[b.id]||'',sec,img:images[b.id]||null}});
  return{title:doc.title||'Práctica de Packet Tracer',student:doc.student,group:doc.group,items,st:stats(),nowStr:new Date().toLocaleString('es-MX',{dateStyle:'long',timeStyle:'short'})}}
const REPORT_BASE=`*{box-sizing:border-box;-webkit-print-color-adjust:exact;print-color-adjust:exact}
