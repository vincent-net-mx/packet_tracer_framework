function parseTemplate(src,fname){src=src.replace(/^\uFEFF/,'').replace(/\r\n?/g,'\n');const info={title:'',student:'',group:''};let lines=src.split('\n');
  if(lines[0].trim()==='---'){let j=1;while(j<lines.length&&!/^(---|\.\.\.)\s*$/.test(lines[j]))j++;
    if(j<lines.length){for(let k=1;k<j;k++){const m=lines[k].match(/^\s*([\wáéíóúñÁÉÍÓÚ]+)\s*:\s*(.*)$/);if(!m)continue;const key=m[1].toLowerCase(),val=m[2].trim().replace(/^["']|["']$/g,'');
      if(/^(titulo|título|title|practica|práctica)$/.test(key))info.title=val;else if(/^(estudiante|alumno|autor|author|nombre|name|student)$/.test(key))info.student=val;else if(/^(grupo|materia|group|matricula|matrícula|curso)$/.test(key))info.group=val}
      lines=lines.slice(j+1)}}
  const blocks=[],imgs={};let para=[];const flush=()=>{if(para.length){const t=para.join('\n').trim();if(t)blocks.push(mk('p',{text:t}));para=[]}};
  const quote=n=>{let k=n+1;while(k<lines.length&&!lines[k].trim())k++;const buf=[];while(k<lines.length&&/^\s*>/.test(lines[k])){buf.push(lines[k].replace(/^\s*>\s?/,''));k++}return buf.length?[buf.join('\n').trim(),k-1]:['',n]};
  for(let n=0;n<lines.length;n++){const l=lines[n];let m;
    if((m=l.match(/^\s*(`{3,}|~{3,})\s*([^\s`]*)\s*$/))){flush();const ch=m[1][0],buf=[];n++;while(n<lines.length&&!(/^\s*(`{3,}|~{3,})\s*$/.test(lines[n])&&lines[n].trim()[0]===ch)){buf.push(lines[n]);n++}blocks.push(mk('code',{text:buf.join('\n'),lang:m[2]||''}));continue}
    if((m=l.match(/^(#{1,6})\s+(.+?)\s*#*\s*$/))){flush();const lv=m[1].length,t=m[2];
      if(lv<=3)blocks.push(mk(['h1','h2','h3'][lv-1],{text:t}));
      else if(lv===4){const[a,e]=quote(n);n=e;blocks.push(mk('q',{text:t,ans:/^_?sin respuesta registrada\._?$/i.test(a)?'':a}))}
      else blocks.push(mk('p',{text:'**'+t+'**'}));continue}
    if((m=l.match(/^\s*!\[([^\]]*)\]\(([^)]*)\)\s*$/))){flush();const b=mk('img',{cap:m[1].trim()});const u=m[2].trim();
      if(/^data:image\//.test(u))imgs[b.id]={id:b.id,dataUrl:u,name:'imagen',updatedAt:''};const[a,e]=quote(n);if(a){b.note=a.replace(/^\*\*Observaci[oó]n t[eé]cnica:\*\*\s*/i,'');n=e}blocks.push(b);continue}
    if((m=l.match(/^\s*_?\*?[\[<]\s*(?:IMAGEN|IMG|CAPTURA|EVIDENCIA)(?:\s+PENDIENTE)?\s*:\s*(.+?)\s*[\]>]\*?_?\s*$/i))){flush();blocks.push(mk('img',{cap:m[1]}));continue}
    if(/^\s*(-{3,}|\*{3,}|_{3,})\s*$/.test(l)){flush();continue}
    if(!l.trim()){flush();continue}
    para.push(l)}
  flush();if(!info.title)info.title=(fname||'').replace(/\.(md|markdown|txt)$/i,'').replace(/[_]+/g,' ').trim();
  const hs=blocks.filter(b=>LV[b.t]),numd=hs.filter(b=>/^(?:(?:paso|parte|secci[oó]n|subsecci[oó]n|fase|tarea|ejercicio|actividad)\s*)?\d+(?:[.\-]\d+)*[.):]?(?:\s|$)/i.test(b.text)).length;
  return{info,blocks,imgs,numbering:!(hs.length&&numd/hs.length>=.5)}}
