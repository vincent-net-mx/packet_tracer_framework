function normDoc(p){return{title:p.title||'',student:p.student||'',group:p.group||'',numbering:p.numbering!==false,blocks:(p.blocks||[]).map(b=>({...mk(TNAME[b.t]?b.t:'p'),...b,t:TNAME[b.t]?b.t:'p'}))}}
const idb=(mode,fn)=>new Promise((res,rej)=>{if(!db)return rej();try{const r=fn(db.transaction('imgs',mode).objectStore('imgs'));r.onsuccess=()=>res(r.result);r.onerror=()=>rej(r.error)}catch(e){rej(e)}});
const initDB=()=>new Promise((res,rej)=>{try{const r=indexedDB.open(DBN,1);r.onupgradeneeded=e=>{if(!e.target.result.objectStoreNames.contains('imgs'))e.target.result.createObjectStore('imgs',{keyPath:'id'})};r.onsuccess=e=>{db=e.target.result;res()};r.onerror=()=>rej(r.error)}catch(e){rej(e)}});
function blobUrl(d){const[h,b]=d.split(',');const mime=(h.match(/:(.*?);/)||[])[1]||'image/png';const bin=atob(b),u=new Uint8Array(bin.length);for(let i=0;i<bin.length;i++)u[i]=bin.charCodeAt(i);return URL.createObjectURL(new Blob([u],{type:mime}))}
async function putImg(r){try{r.url=blobUrl(r.dataUrl)}catch(e){return}images[r.id]=r;const{url,...rec}=r;try{await idb('readwrite',s=>s.put(rec))}catch(e){}}
async function delImg(id){const r=images[id];if(r&&r.url)URL.revokeObjectURL(r.url);delete images[id];try{await idb('readwrite',s=>s.delete(id))}catch(e){}}
async function clearImgs(){Object.values(images).forEach(r=>r.url&&URL.revokeObjectURL(r.url));images={};try{await idb('readwrite',s=>s.clear())}catch(e){}}

